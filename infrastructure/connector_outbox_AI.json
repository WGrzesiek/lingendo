{
  "name": "outbox-koog-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "slot.name": "dbz_sales_transaction_slot",

    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "admin",
    "database.password": "adminpassword",
    "database.dbname": "koog",

    "table.include.list": "public.outbox",
    "database.server.name": "outbox",
    "topic.prefix": "outbox",

    "key.converter.schemas.enable": "false",
    "value.converter.schemas.enable": "false",
    "transforms": "route",
    "transforms.route.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.route.table.field.event.id": "event_id",
    "transforms.route.table.field.event.key": "aggregate_id",
    "transforms.route.table.field.event.type": "event_type",
    "transforms.route.table.field.event.payload": "payload",
    "transforms.route.route.by.field": "aggregate_type",
    "transforms.route.topic.regex": "([^.]+)\\.([^.]+)\\.outbox",
    "transforms.route.topic.replacement": "$2.events",
    "transforms.route.table.expand.json.payload": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter"
  }
}
