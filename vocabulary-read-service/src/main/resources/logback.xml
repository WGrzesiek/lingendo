<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>


    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>localhost:50000</destination>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>vocabulary-read-service</serviceName>
        </encoder>
    </appender>

    <!-- Appender dla logów Kafka -->
    <appender name="LOGSTASH_KAFKA" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>localhost:50000</destination>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>vocabulary-read-kafka-service</serviceName>
        </encoder>
    </appender>

    <!-- Logger dla pakietów Kafka -->
    <logger name="org.apache.kafka" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_KAFKA" />
    </logger>

    <logger name="org.springframework.kafka" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_KAFKA" />
    </logger>

    <!-- Appender dla logów MongoDB -->
    <appender name="LOGSTASH_MONGODB" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>localhost:50000</destination>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>vocabulary-read-mongodb-service</serviceName>
        </encoder>
    </appender>

    <!-- Logger dla MongoDB -->
    <logger name="org.mongodb" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_MONGODB" />
    </logger>

    <logger name="org.springframework.data.mongodb" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_MONGODB" />
    </logger>

    <root level="INFO">
        <appender-ref ref="LOGSTASH"/>
    </root>
</configuration>

