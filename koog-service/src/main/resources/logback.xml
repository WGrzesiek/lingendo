<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <!-- Główny appender do Logstash -->
    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_HOST:-localhost}:50000</destination>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>koog-service</serviceName>
        </encoder>
    </appender>

    <!-- Appender dla logów Kafka -->
    <appender name="LOGSTASH_KAFKA" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_HOST:-localhost}:50000</destination>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>koog-kafka-service</serviceName>
        </encoder>
    </appender>

    <!-- Logger dla pakietów Kafka -->
    <logger name="org.apache.kafka" level="${LOG_LEVEL_KAFKA:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_KAFKA" />
    </logger>

    <logger name="org.springframework.kafka" level="${LOG_LEVEL_KAFKA:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_KAFKA" />
    </logger>

    <!-- Appender dla logów AI/OpenAI -->
    <appender name="LOGSTASH_AI" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_HOST:-localhost}:50000</destination>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>koog-ai-service</serviceName>
        </encoder>
    </appender>

    <!-- Logger dla pakietów AI -->
    <logger name="ai.koog" level="${LOG_LEVEL_AI:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_AI" />
    </logger>

    <logger name="com.learnwords.koogservice.ai" level="${LOG_LEVEL_AI:-DEBUG}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_AI" />
    </logger>

    <!-- Appender dla logów PostgreSQL -->
    <appender name="LOGSTASH_POSTGRES" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_HOST:-localhost}:50000</destination>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>koog-postgres-service</serviceName>
        </encoder>
    </appender>

    <!-- Logger dla PostgreSQL -->
    <logger name="org.postgresql" level="${LOG_LEVEL_POSTGRESQL:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_POSTGRES" />
    </logger>

    <logger name="org.hibernate" level="${LOG_LEVEL_HIBERNATE:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_POSTGRES" />
    </logger>

    <logger name="org.flywaydb" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH_POSTGRES" />
    </logger>

    <!-- Logger dla aplikacji -->
    <logger name="com.learnwords.koogservice" level="${LOG_LEVEL_APP:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH" />
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOGSTASH"/>
    </root>
</configuration>
